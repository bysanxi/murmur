{
  "name": "三息之间",
  "version": "0.1.0",
  "authors": ["hiudong"],
  "license": "MIT",
  "description": "A quiet pond on the desktop. The light changes with the time of day.",
  "entry": "index.jsx",
  "x": 0,
  "y": 0,
  "width": 3840,
  "height": 2160,
  "zIndex": -1,
  "options": [
    { "key": "turtles", "label": "乌龟", "type": "bool", "default": true },
    { "key": "crabs", "label": "蟹", "type": "bool", "default": true },
    {
      "key": "butterflies",
      "label": "蝴蝶与蜻蜓",
      "type": "bool",
      "default": true
    },
    { "key": "silverCarp", "label": "青鲢", "type": "bool", "default": true },
    {
      "key": "quality",
      "label": "画面品质",
      "type": "select",
      "default": "high",
      "options": [
        { "value": "high", "label": "细腻" },
        { "value": "eco", "label": "节能" }
      ]
    },
    {
      "key": "style",
      "label": "画风",
      "type": "select",
      "default": "real",
      "options": [
        { "value": "real", "label": "写实" },
        { "value": "xieyi", "label": "写意" }
      ]
    },
    {
      "key": "rainAmount",
      "label": "雨量",
      "type": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "snowAmount",
      "label": "雪量",
      "type": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "followTime",
      "label": "跟随时间",
      "type": "bool",
      "default": true
    },
    {
      "key": "weather",
      "label": "天气",
      "type": "select",
      "default": "sunny",
      "whenKey": "followTime",
      "whenValue": false,
      "options": [
        { "value": "sunny", "label": "晴" },
        { "value": "cloudy", "label": "多云" },
        { "value": "rain", "label": "雨" },
        { "value": "snow", "label": "雪" }
      ]
    },
    {
      "key": "night",
      "label": "月下观鱼",
      "type": "bool",
      "default": false,
      "whenKey": "followTime",
      "whenValue": false
    },
    {
      "key": "speed",
      "label": "游动速度",
      "type": "number",
      "default": 0.7,
      "min": 0.3,
      "max": 2,
      "step": 0.1,
      "whenKey": "followTime",
      "whenValue": false
    }
  ]
}
